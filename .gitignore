# --- Dependencies ---
node_modules/

# --- Build output ---
# esbuild bundle / legacy hand-rolled artifacts
dist/
# Temporary bundle dirs created by scripts/generate-openapi.mjs (normally
# auto-removed; guard against stray dirs if the script is interrupted).
.openapi-tmp-*/

# --- AWS SAM ---
# Local build cache and generated artifacts (regenerated by `sam build`)
.aws-sam/
# Local packaged template output
packaged.yaml

# --- Test / coverage ---
coverage/
*.lcov

# --- Local environment / secrets ---
# The real env.json is a local-only file (may contain endpoints/credentials
# for local runs). Commit env.json.example instead.
env.json
.env
.env.*
!.env.example
*.pem
*.key

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Editor / IDE ---
.idea/
*.swp
*.swo
# VS Code: keep shared settings, ignore personal workspace state
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# --- Kiro ---
# Commit specs, steering, and hooks so the team shares conventions and plans.
# Guard against local-only or secret-bearing files that may appear later.

# Local MCP server config often holds endpoints/tokens; keep a shareable
# example committed instead (.kiro/settings/mcp.json.example).
.kiro/settings/mcp.json

# Any user/local-scoped Kiro config or cache
.kiro/**/*.local
.kiro/**/local/

# Optional: uncomment if per-task metadata churn becomes noisy in diffs.
# .kiro/specs/**/tasks.meta.json
